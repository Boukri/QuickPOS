<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:QuickPOS.Models.Enums"
		xmlns:core="clr-namespace:QuickPOS.Core"
		x:Class="QuickPOS.Features.Inventory.Components.ReceiveStockDialog"
        Title="Receive Stock"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

	<Border Background="{StaticResource SurfaceLowestBrush}"
            CornerRadius="16" Padding="36" Width="520"
            Margin="20">
		<Border.Effect>
			<DropShadowEffect BlurRadius="40" Opacity="0.18" ShadowDepth="8"/>
		</Border.Effect>
		<StackPanel>

			<!-- Header -->
			<DockPanel Margin="0,0,0,20">
				<StackPanel>
					<TextBlock Text="{Binding InvReceiveStock, Source={x:Static core:LocalizationService.Instance}}" FontFamily="Inter, Segoe UI" FontSize="11"
							   FontWeight="ExtraBold" Foreground="{StaticResource OnSurfaceVariantBrush}"/>
					<TextBlock Text="{Binding InvReceiveStockSubtitle, Source={x:Static core:LocalizationService.Instance}}"
							   FontFamily="Inter, Segoe UI" FontSize="12"
							   Foreground="{StaticResource OutlineBrush}" Margin="0,2,0,0"/>
				</StackPanel>
				<Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Content="&#x2715;" Width="32" Height="32"
                        Style="{StaticResource IconButtonStyle}"
                        Click="Cancel_Click"/>
			</DockPanel>

			<!-- Product selector -->
			<TextBlock Text="{Binding InvColProduct, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
			<ComboBox ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      Style="{StaticResource FormComboStyle}"
                      Margin="0,0,0,16"/>

			<!-- Quantity + Purchase price row -->
			<Grid Margin="0,0,0,16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="{Binding InvFieldQtyReceived, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
					<TextBox Text="{Binding ReceiveQuantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInputStyle}"/>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="{Binding InvFieldPurchasePrice, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
					<TextBox Text="{Binding ReceiveUnitCost, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInputStyle}"/>
				</StackPanel>
			</Grid>

			<!-- Sell price + Costing method row -->
			<Grid Margin="0,0,0,16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="{Binding InvFieldSellingPrice, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
					<TextBox Text="{Binding ReceiveSellPrice, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInputStyle}"/>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="{Binding InvFieldCostingMethod, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
					<ComboBox SelectedValue="{Binding ReceiveCostingMethod}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource FormComboStyle}">
						<ComboBoxItem Content="{Binding CostingWeightedAverage, Source={x:Static core:LocalizationService.Instance}}" Tag="{x:Static local:CostingMethod.WeightedAverage}"/>
						<ComboBoxItem Content="{Binding CostingFifo, Source={x:Static core:LocalizationService.Instance}}"            Tag="{x:Static local:CostingMethod.Fifo}"/>
						<ComboBoxItem Content="{Binding CostingLifo, Source={x:Static core:LocalizationService.Instance}}"            Tag="{x:Static local:CostingMethod.Lifo}"/>

					</ComboBox>
				</StackPanel>
			</Grid>

			<!-- Reference / PO# -->
			<TextBlock Text="{Binding InvFieldReference, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
			<TextBox Text="{Binding ReceiveReference, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormInputStyle}"
                     Margin="0,0,0,28"/>

			<!-- Actions -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="12"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" Content="{Binding Cancel, Source={x:Static core:LocalizationService.Instance}}"
						Style="{StaticResource SecondaryButtonStyle}"
						Height="48" Click="Cancel_Click"/>
				<Button Grid.Column="2" Content="{Binding InvSaveBatch, Source={x:Static core:LocalizationService.Instance}}"
						Style="{StaticResource PrimaryButtonStyle}"
						Height="48" Command="{Binding ConfirmReceiveStockCommand}"/>
			</Grid>

		</StackPanel>
	</Border>
</Window>
