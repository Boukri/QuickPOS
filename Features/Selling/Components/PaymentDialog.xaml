<Window x:Class="QuickPOS.Features.Selling.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:QuickPOS.Core"
        Title="Payment"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        xmlns:local="clr-namespace:QuickPOS.Features.Selling.Components"
        FlowDirection="{Binding Source={x:Static core:LocalizationService.Instance}, Path=FlowDirection}">

    <Border Background="White" CornerRadius="16" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.20" ShadowDepth="0" Color="#1E293B"/>
        </Border.Effect>

        <StackPanel Margin="36,32">

            <!-- Header -->
            <DockPanel Margin="0,0,0,28">
                <TextBlock Text="{Binding  Source={x:Static core:LocalizationService.Instance}, Path=Payment, Mode=OneWay}"
                           FontFamily="Manrope, Segoe UI" FontSize="22" FontWeight="ExtraBold"
                           Foreground="{StaticResource OnSurfaceBrush}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Content="&#x2715;" Width="32" Height="32"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CloseButton_Click"/>
            </DockPanel>

            <!-- Total row -->
            <Border Background="{StaticResource SurfaceLowBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,20">
                <DockPanel>
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=Total}"
                               FontFamily="Inter, Segoe UI" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               FontFamily="Manrope, Segoe UI" FontSize="28" FontWeight="ExtraBold"
                               Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right">
                        <TextBlock.Text>
                            <Binding Path="TotalAmount" StringFormat="{}{0:C}"/>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Client bill input -->
            <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=GivingAmount }"
                       FontFamily="Inter, Segoe UI" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       Margin="4,0,0,8"/>
            <TextBox Text="{Binding ClientBillText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormInputStyle}"
                     Height="52" FontSize="18" FontFamily="Manrope, Segoe UI"
                     x:Name="BillInput"
                     local:TextBoxBehavior.SelectAllOnLoad="True"/>

            <!-- Numpad -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: 7 8 9 -->
                <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="7"/>
                <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="8"/>
                <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="9"/>

                <!-- Row 2: 4 5 6 -->
                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="4"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="5"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="6"/>

                <!-- Row 3: 1 2 3 -->
                <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="1"/>
                <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="3"/>

                <!-- Row 4: . 0 ⌫ -->
                <Button Grid.Row="3" Grid.Column="0" Content="." Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="."/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadKeyStyle}" Command="{Binding NumpadPressCommand}" CommandParameter="0"/>
                <Button Grid.Row="3" Grid.Column="2" Content="&#x232B;" Style="{StaticResource NumpadActionStyle}" Command="{Binding NumpadBackspaceCommand}"/>
            </Grid>

            <!-- Insufficient warning -->
            <TextBlock Text="{Binding  Source={x:Static core:LocalizationService.Instance}, Path=InsufficientAmount}"
                       FontFamily="Inter, Segoe UI" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource ErrorBrush}"
                       Margin="4,6,0,0"
                       Visibility="{Binding IsInsufficient, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- Change row -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceLowBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInsufficient}" Value="False">
                                <Setter Property="Background" Value="#E6F4F1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=CashReturned}"
                               FontFamily="Inter, Segoe UI" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               FontFamily="Manrope, Segoe UI" FontSize="28" FontWeight="ExtraBold"
                               HorizontalAlignment="Right">
                        <TextBlock.Text>
                            <Binding Path="Change" StringFormat="{}{0:C}"/>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInsufficient}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Confirm button -->
            <Button Content="{Binding Source={x:Static core:LocalizationService.Instance}, Path=Confirm}"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="52" FontSize="15" FontWeight="Bold"
                    Margin="0,24,0,0"/>

        </StackPanel>
    </Border>
</Window>
