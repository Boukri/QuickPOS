<Window x:Class="QuickPOS.Features.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:core="clr-namespace:QuickPOS.Core"
        mc:Ignorable="d"
        Title="Login - QuickPOS"
        Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{Binding Source={x:Static core:LocalizationService.Instance}, Path=FlowDirection}">
    <Border Background="White" CornerRadius="16" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.25" ShadowDepth="0" Color="#1E293B"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left branding panel ===== -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#02645F" Offset="0"/>
                        <GradientStop Color="#2D7D78" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <Image Source="/QuickPOSLogo/1.png" Width="88" Height="88" Margin="0,0,0,24"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="QuickPOS" FontFamily="Manrope, Segoe UI" FontSize="34" FontWeight="ExtraBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="The Clinical Sanctuary" FontFamily="Inter, Segoe UI" FontSize="13"
                               Foreground="#A4F0EA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <!-- Default credentials card -->
                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16,12" Margin="0,40,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=DefaultCreds}"
                                       FontFamily="Inter, Segoe UI" FontSize="10" FontWeight="ExtraBold"
                                       Foreground="#A4F0EA" Margin="0,0,0,8"/>
                            <TextBlock FontFamily="Inter, Segoe UI" FontSize="12" Foreground="White">
                                <Run Text="admin" FontFamily="Consolas"/>
                            </TextBlock>
                            <TextBlock FontFamily="Inter, Segoe UI" FontSize="12" Foreground="White" Margin="0,4,0,0">
                                <Run Text="Admin@123" FontFamily="Consolas"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Language switcher on login screen -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <RadioButton x:Name="LangFrBtn" Content="Français" GroupName="LoginLang"
                                     Foreground="White" FontFamily="Inter, Segoe UI" FontSize="12" Cursor="Hand"
                                     Checked="LangFr_Checked" Margin="0,0,16,0"/>
                        <RadioButton x:Name="LangArBtn" Content="العربية" GroupName="LoginLang"
                                     Foreground="White" FontFamily="Inter, Segoe UI" FontSize="12" Cursor="Hand"
                                     Checked="LangAr_Checked"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Right form panel ===== -->
            <Grid Grid.Column="1">
                <!-- Close button -->
                <Button Content="x" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="36" Height="36" Margin="0,12,12,0" FontSize="14" FontWeight="Bold"
                        Click="CloseButton_Click"
                        Style="{StaticResource IconButtonStyle}"/>

                <StackPanel VerticalAlignment="Center" Margin="48,0">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=WelcomeBack}"
                               FontFamily="Manrope, Segoe UI" FontSize="26" FontWeight="ExtraBold"
                               Foreground="{StaticResource OnSurfaceBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=SignInSubtitle}"
                               FontFamily="Inter, Segoe UI" FontSize="13"
                               Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,32"/>

                    <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=LabelUsername}"
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInputStyle}" Height="48"/>

                    <TextBlock Text="{Binding Source={x:Static core:LocalizationService.Instance}, Path=LabelPassword}"
                               Style="{StaticResource FormLabelStyle}"/>
                    <!-- Password field with visibility toggle -->
                    <Grid Height="48" Margin="0,0,0,16">
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource FormPasswordStyle}"
                                     Height="48" Margin="0"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"/>
                        <TextBox x:Name="PasswordText"
                                 Style="{StaticResource FormInputStyle}"
                                 Height="48" Margin="0"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"/>
                        <ToggleButton x:Name="EyeToggle"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,12,0" Width="32" Height="32" Cursor="Hand"
                                      Checked="EyeToggle_Checked" Unchecked="EyeToggle_Unchecked">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <materialIcons:MaterialIcon x:Name="EyeIcon" Kind="EyeOutline"
                                                        Width="20" Height="20"
                                                        Foreground="{StaticResource OutlineBrush}"/>
                        </ToggleButton>
                    </Grid>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontFamily="Inter, Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"/>

                    <!-- Remember Me -->
                    <CheckBox Content="{Binding Source={x:Static core:LocalizationService.Instance}, Path=RememberMe}"
                              IsChecked="{Binding RememberMe}"
                              FontFamily="Inter, Segoe UI" FontSize="13"
                              Foreground="{StaticResource OnSurfaceVariantBrush}"
                              Margin="0,0,0,0" Cursor="Hand"/>

                    <!-- Sign In Button -->
                    <Button Command="{Binding LoginCommand}" Height="50" Margin="0,24,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="{Binding Source={x:Static core:LocalizationService.Instance}, Path=BtnSignIn}"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Content" Value="{Binding Source={x:Static core:LocalizationService.Instance}, Path=BtnSigningIn}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

</Window>
