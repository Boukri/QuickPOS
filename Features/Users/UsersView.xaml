<UserControl x:Class="QuickPOS.Features.Users.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:fa="https://dsaladin.dev/products/fontawesome/wpf/xaml"
             xmlns:core="clr-namespace:QuickPOS.Core"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{StaticResource SurfaceBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!--  Header -->
                <DockPanel Margin="0,0,0,40">
                    <StackPanel>
                        <TextBlock Text="{Binding UsersStaffDirectory, Source={x:Static core:LocalizationService.Instance}}" FontFamily="Manrope, Segoe UI" FontSize="42"
                                   FontWeight="ExtraBold" Foreground="{StaticResource OnSurfaceBrush}"
                                   Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding UsersStaffSubtitle, Source={x:Static core:LocalizationService.Instance}}"
                                       FontFamily="Inter, Segoe UI" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding ShowAddFormCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Height="56" Padding="32,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UsersInviteNew, Source={x:Static core:LocalizationService.Instance}}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!--  Staff Table -->
                <Border Background="{StaticResource SurfaceLowBrush}" CornerRadius="12">
                    <DockPanel>
                        <!-- Table Header Bar -->
                        <Border DockPanel.Dock="Top" Background="White" Padding="32,20" CornerRadius="12,12,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding UsersTeamMembers, Source={x:Static core:LocalizationService.Instance}}" FontFamily="Manrope, Segoe UI" FontSize="18"
                                           FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Table Footer -->
                        <Border DockPanel.Dock="Bottom" Background="White" Padding="32,20"
                                BorderBrush="{StaticResource SurfaceContainerBrush}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,12">
                            <DockPanel>
                                <TextBlock FontFamily="Inter, Segoe UI" FontSize="12" FontStyle="Italic"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}{0} {1} {2}">
											<Binding Path="Showing"          Source="{x:Static core:LocalizationService.Instance}" />
											<Binding Path="Users.Count" />
											<Binding Path="UsersStaffMembers" Source="{x:Static core:LocalizationService.Instance}" />
										</MultiBinding>
									</TextBlock.Text>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Table Content -->
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="32,20" Background="White" Margin="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar + Name -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,32,0">
                                                <Border Width="48" Height="48" CornerRadius="24"
                                                        Background="#E0F2F1" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Initials}" FontFamily="Manrope, Segoe UI"
                                                               FontWeight="Bold" FontSize="15"
                                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontFamily="Manrope, Segoe UI"
                                                               FontWeight="Bold" FontSize="14"
                                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                                    <TextBlock Text="{Binding Email}" FontFamily="Inter, Segoe UI" FontSize="12"
                                                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Contact (fills space) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"/>

                                            <!-- Role Badge -->
                                            <Border Grid.Column="2" CornerRadius="12" Padding="12,4"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                <Setter Property="Background" Value="#D5E3FC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="Manager">
                                                                <Setter Property="Background" Value="#10024F5F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Role}" FontFamily="Inter, Segoe UI" FontSize="10"
                                                           FontWeight="ExtraBold"
                                                           TextAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                    <Setter Property="Foreground" Value="#57657A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="Manager">
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border.ToolTip>
                                                    <ToolTip MaxWidth="280">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Role, StringFormat='{}{0} Permissions'}"
                                                                       FontFamily="Manrope, Segoe UI" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding RoleDescription}" FontFamily="Inter, Segoe UI"
                                                                       FontSize="12" TextWrapping="Wrap" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>

                                            <!-- Status -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,0,16,0">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#CBD5E1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                    <Setter Property="Fill" Value="{StaticResource PrimaryDarkBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}" FontFamily="Inter, Segoe UI" FontSize="13"
                                                           FontWeight="Medium" Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
													<Button Style="{StaticResource TableEditButtonStyle}"
                                                            Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
														<fa:FontAwesomeImage Icon="RegularPenToSquare" Foreground="{StaticResource SuccessBrush}" Width="25"/>
													</Button>
													<Button Style="{StaticResource TableEditButtonStyle}"
																		Command="{Binding DataContext.RequestDeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																		CommandParameter="{Binding}" Margin="4,0,0,0"
																		Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisConverter}}">
														<fa:FontAwesomeImage Icon="SolidXmark"   Foreground="{StaticResource ErrorBrush}"  Width="25" />
													</Button>
                                                </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Add/Edit Form Modal -->
        <Border Background="#80000000"
                Visibility="{Binding IsDeleteConfirmVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="White" CornerRadius="12" Width="420" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.15" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmDeletion, Source={x:Static core:LocalizationService.Instance}}"
                               FontFamily="Manrope, Segoe UI" FontSize="20" FontWeight="ExtraBold"
                               Foreground="{StaticResource OnSurfaceBrush}" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DeleteWarning, Source={x:Static core:LocalizationService.Instance}}"
                               FontFamily="Inter, Segoe UI" FontSize="13" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,32"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{Binding Cancel, Source={x:Static core:LocalizationService.Instance}}"
                                Command="{Binding CancelDeleteUserCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2"
                                Content="{Binding Confirm, Source={x:Static core:LocalizationService.Instance}}"
                                Command="{Binding ConfirmDeleteUserCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!--  Add/Edit Form Modal -->
        <Border Background="#80000000"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="White" CornerRadius="16" Width="440" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.15" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontFamily="Manrope, Segoe UI" FontSize="22" FontWeight="ExtraBold"
                               Foreground="{StaticResource OnSurfaceBrush}" Margin="0,0,0,24"/>

                    <TextBlock Text="{Binding UsersFieldFullName, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}"/>

                    <TextBlock Text="{Binding UsersFieldEmail, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}"/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInputStyle}"
                             Tag="Leave blank to keep current password"/>

                    <TextBlock Text="{Binding UsersFieldStatus, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding FormStatus}"
                              Style="{StaticResource FormComboStyle}"/>

                    <!-- Nav-access permission checkboxes -->
                    <TextBlock Text="{Binding UsersFieldPermissions, Source={x:Static core:LocalizationService.Instance}}" Style="{StaticResource FormLabelStyle}"/>
                    <Border Background="{StaticResource SurfaceLowBrush}" CornerRadius="10"
                            Padding="16,10" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding FormPermissions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              FontFamily="Inter, Segoe UI" FontSize="13"
                                              Foreground="{StaticResource OnSurfaceBrush}"
                                              Margin="0,5,0,5" Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{Binding Cancel,     Source={x:Static core:LocalizationService.Instance}}" Command="{Binding CancelFormCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Height="44" Margin="0,0,12,0"/>
                        <Button Content="{Binding UsersSave,  Source={x:Static core:LocalizationService.Instance}}" Command="{Binding SaveUserCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="44"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
