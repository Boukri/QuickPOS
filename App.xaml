<Application x:Class="QuickPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickPOS"
             xmlns:core="clr-namespace:QuickPOS.Core"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Global implicit TextBlock style ensures Arabic fallback font everywhere -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Manrope, Segoe UI, Arial"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <core:EqualityConverter x:Key="EqualityConverter"/>
            <core:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisConverter"/>
            <core:StringToVisibilityConverter x:Key="StringToVisConverter"/>
            <core:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <core:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <core:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <core:GreaterThanZeroVisibilityConverter x:Key="GreaterThanZeroVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
  
</Application>
