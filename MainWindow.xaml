<Window x:Class="QuickPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickPOS"
        xmlns:core="clr-namespace:QuickPOS.Core"
        xmlns:selling="clr-namespace:QuickPOS.Features.Selling"
        xmlns:products="clr-namespace:QuickPOS.Features.Products"
        xmlns:dashboard="clr-namespace:QuickPOS.Features.Dashboard"
        xmlns:users="clr-namespace:QuickPOS.Features.Users"
        xmlns:dailyclose="clr-namespace:QuickPOS.Features.DailyClose"
        xmlns:inventory="clr-namespace:QuickPOS.Features.Inventory"
        xmlns:fa="https://dsaladin.dev/products/fontawesome/wpf/xaml"
        mc:Ignorable="d"
        Title="QuickPOS"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F6"
        FlowDirection="{Binding Loc.FlowDirection}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side Navigation -->
        <Border x:Name="SideNav" Grid.Column="0" Background="#1E293B" ClipToBounds="True" Width="180">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,20">
                    <StackPanel>
                        <Image Source="QuickPOSLogo/1.png" Width="48" Height="48"
                               HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="LogoSubtitle" Text="{Binding Loc.NavPosManager}"
                                   FontFamily="Inter, Segoe UI" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top" Background="#334155" Margin="16,0"/>

                <!-- Navigation Items -->
                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource NavRadioStyle}"
                                 IsChecked="{Binding CurrentNavIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=0}"
                                 Command="{Binding NavigateToSellingCommand}"
                                 ToolTip="{Binding Loc.NavPosTerminal}"
                                 Visibility="{Binding CanAccessSelling, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesomeImage Icon="SolidCashRegister" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc.NavPosTerminal}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadioStyle}"
                                 IsChecked="{Binding CurrentNavIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=1}"
                                 Command="{Binding NavigateToProductsCommand}"
                                 ToolTip="{Binding Loc.NavProducts}"
                                 Visibility="{Binding CanAccessProducts, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesomeImage Icon="SolidBox" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc.NavProducts}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadioStyle}"
                                 IsChecked="{Binding CurrentNavIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=5}"
                                 Command="{Binding NavigateToInventoryCommand}"
                                  Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVisConverter}}"
                                 ToolTip="{Binding Loc.NavInventory}">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesomeImage Icon="SolidLayerGroup" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc.NavInventory}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadioStyle}"
                                 IsChecked="{Binding CurrentNavIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=2}"
                                 Command="{Binding NavigateToDashboardCommand}"
                                 ToolTip="{Binding Loc.NavDashboard}"
                                 Visibility="{Binding CanAccessDashboard, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesomeImage Icon="SolidChartLine" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc.NavDashboard}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadioStyle}"
                                 IsChecked="{Binding CurrentNavIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=4}"
                                 Command="{Binding NavigateToDailyCloseCommand}"
                                 ToolTip="{Binding Loc.NavDailyClose}"
                                 Visibility="{Binding CanAccessDailyClose, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesomeImage Icon="SolidCalendarCheck" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc.NavDailyClose}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadioStyle}"
                                 IsChecked="{Binding CurrentNavIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=3}"
                                 Command="{Binding NavigateToUsersCommand}"
                                 ToolTip="{Binding Loc.NavUsers}"
                                 Visibility="{Binding CanAccessUsers, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesomeImage Icon="SolidUsers" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc.NavUsers}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Language Switcher at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,20">
                    <Separator Background="#334155" Margin="4,0,4,12"/>
                    <TextBlock Text="{Binding Loc.LangLabel}" FontFamily="Inter, Segoe UI" FontSize="10"
                               FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding Loc.LangFrench}"
                                     GroupName="Language"
                                     Style="{StaticResource NavRadioStyle}"
                                     IsChecked="{Binding Loc.IsArabic, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                                     Command="{Binding SetFrenchCommand}"
                                     FontFamily="Segoe UI" FontSize="12" Height="36"/>
                        <RadioButton Content="{Binding Loc.LangArabic}"
                                     GroupName="Language"
                                     Style="{StaticResource NavRadioStyle}"
                                     IsChecked="{Binding Loc.IsArabic, Mode=OneWay}"
                                     Command="{Binding SetArabicCommand}"
                                     FontFamily="Segoe UI" FontSize="12" Height="36"/>
                    </StackPanel>
                </StackPanel>

                <Border/>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <DockPanel Grid.Column="1">
            <!-- Top Navigation Bar -->
            <Border DockPanel.Dock="Top" Background="White" Height="60"
                    BorderBrush="#E6E8EA" BorderThickness="0,0,0,1">
                <DockPanel Margin="4,0">
                    <!-- Burger Toggle Button -->
                    <ToggleButton x:Name="NavToggle" VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="False" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="brgBorder" Background="Transparent" Width="36" Height="36"
                                        CornerRadius="8" ToolTip="Toggle sidebar">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="20">
                                        <Border Height="2" Background="#1E293B" CornerRadius="1" Margin="0,0,0,4"/>
                                        <Border Height="2" Background="#1E293B" CornerRadius="1" Margin="0,0,0,4"/>
                                        <Border Height="2" Background="#1E293B" CornerRadius="1"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="brgBorder" Property="Background" Value="#F2F4F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="{Binding CurrentPageTitle}" FontFamily="Manrope, Segoe UI" FontSize="16"
                               FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#E0F2F1" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentUserInitials}" FontFamily="Manrope, Segoe UI" FontWeight="Bold" FontSize="13"
                                       Foreground="#2D7D78" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentUserName}" FontFamily="Manrope, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="{Binding Loc.BtnLogout}" Command="{Binding LogoutCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Padding="16,0" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl Content="{Binding Navigation.CurrentViewModel}" >
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type selling:SellingViewModel}">
                        <selling:SellingView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type products:ProductsViewModel}">
                        <products:ProductsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
                        <dashboard:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type users:UsersViewModel}">
                        <users:UsersView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type dailyclose:DailyCloseViewModel}">
                        <dailyclose:DailyCloseView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type inventory:InventoryBatchViewModel}">
                        <inventory:InventoryBatchView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </DockPanel>
    </Grid>
</Window>
